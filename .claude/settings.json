{
  "hooks": {
    "PostToolUse": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsc --noEmit 2>&1 | tail -20",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[console]::beep(1000, 300); Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; $n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; $n.ShowBalloonTip(5000, 'Claude Code', 'Claude code xong rồi master', [System.Windows.Forms.ToolTipIcon]::Info); Start-Sleep 5; $n.Dispose()",
            "shell": "powershell",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)",

      "Edit(apps/**)",
      "Edit(libs/**)",
      "Edit(.claude/**)",
      "Edit(database/**)",
      "Edit(tsconfig*.json)",
      "Edit(nest-cli.json)",
      "Edit(.env.example)",

      "Bash(npm run start:nodeA)",
      "Bash(npm run start:nodeB)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(curl *)",
      "Bash(netstat *)",
      "Bash(ss *)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git rev-parse*)"
    ],
    "deny": [
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Bash(rm -rf *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose up*)"
    ]
  }
}
