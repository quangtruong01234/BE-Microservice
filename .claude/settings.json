{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(node -p \"(()=>{try{return JSON.parse(require('fs').readFileSync(0,'utf8')).tool_input.file_path||''}catch(e){return ''}})()\"); case \"$f\" in *.ts) cd \"$CLAUDE_PROJECT_DIR\" && { npx prettier --write \"$f\" && npx eslint --fix \"$f\"; } >/dev/null 2>&1 || true;; esac",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && out=$(npx tsc --noEmit 2>&1) || { echo \"$out\" | tail -30 >&2; exit 2; }",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "[console]::beep(1000, 300); Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; $n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; $n.ShowBalloonTip(5000, 'Claude Code', 'Claude code xong rồi master', [System.Windows.Forms.ToolTipIcon]::Info); Start-Sleep 5; $n.Dispose()",
            "shell": "powershell",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)",

      "Edit(apps/**)",
      "Edit(libs/**)",
      "Edit(.claude/**)",
      "Edit(.agent-local/**)",
      "Edit(ai-docs/agent-context/**)",
      "Edit(ai-docs/agent-handoff/**)",
      "Edit(database/**)",
      "Edit(tsconfig*.json)",
      "Edit(nest-cli.json)",
      "Edit(.env.example)",

      "Bash(npm run start:nodeA)",
      "Bash(npm run start:nodeB)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx jest *)",
      "Bash(npm.cmd run start:nodeA)",
      "Bash(npm.cmd run start:nodeB)",
      "Bash(npm.cmd run build*)",
      "Bash(npm.cmd run lint*)",
      "Bash(npm.cmd run test*)",
      "Bash(npx.cmd tsc *)",
      "Bash(npx.cmd eslint *)",
      "Bash(npx.cmd prettier *)",
      "Bash(npx.cmd jest *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(curl *)",
      "Bash(netstat *)",
      "Bash(ss *)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git rev-parse*)"
    ],
    "deny": [
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Bash(rm -rf *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose up*)"
    ]
  }
}
