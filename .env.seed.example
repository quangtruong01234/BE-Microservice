# Template for `.env.seed` (used by scripts/seed/seed-products.mjs).
# Copy to `.env.seed` and fill in real values. `.env.seed` is gitignored;
# this example file is committed and must never contain real credentials.

# Gateway origin, NO trailing slash and NO /api suffix.
SEED_BASE=http://localhost:3000

# Account with the `shop` role — creates the products.
SEED_SHOP_USER=
SEED_SHOP_PASS=

# Account with the `admin` role — approves the seed categories.
# Required only when the target database has no active category yet.
SEED_ADMIN_USER=
SEED_ADMIN_PASS=
