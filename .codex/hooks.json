{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit",
            "commandWindows": "npx tsc --noEmit",
            "timeout": 30,
            "statusMessage": "Running TypeScript validation"
          }
        ]
      }
    ]
  }
}
