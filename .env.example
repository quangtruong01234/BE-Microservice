############################################
# TRYBUY API ENVIRONMENT CONTRACT
############################################
# Copy the relevant node example:
#   Node A: local/nodeA/.env.example -> local/nodeA/.env
#   Node B: local/nodeB/.env.example -> local/nodeB/.env
# Keep real secrets out of git.

############################################
# APP / RUNTIME
############################################
NODE_ENV=development
GATEWAY_PORT=3000
# Gateway HTTP bind host. Default 0.0.0.0 (dev). In production set 127.0.0.1
# so only Nginx is publicly reachable.
GATEWAY_HOST=0.0.0.0

# TypeORM synchronize defaults to true outside production and false in production.
# Leave unset for local development, or set explicitly for deployments.
TYPEORM_SYNCHRONIZE=false
# Only set true for an intentional one-off production schema sync.
TYPEORM_SYNCHRONIZE_ALLOW_PRODUCTION=false

############################################
# AUTH / CORS
############################################
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated origins. Production allows only this list.
FRONTEND_URL=http://localhost:5173,http://localhost:3013
# Cookie defaults keep local HTTP working. In production, secure=true automatically.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# Swagger is enabled by default outside production and disabled by default in production.
SWAGGER_ENABLED=true
# Gateway request body limits. Product/image URL payloads should fit comfortably.
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
# Global gateway rate limit defaults; auth endpoints have stricter per-route limits.
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_TTL_SECONDS=60
RATE_LIMIT_REDIS_TIMEOUT_MS=500
# Skip the Redis counter for @Public GET/HEAD routes without an explicit
# @RateLimit. Set true ONLY when nginx `limit_req` already fronts the gateway.
RATE_LIMIT_SKIP_PUBLIC_GET=false

# pm2 cluster size for the gateway (ecosystem.config.js). Values > 1 require the
# frontends to open Socket.IO with transports:["websocket"] — round-robin breaks
# the polling handshake without sticky sessions.
GATEWAY_INSTANCES=1

############################################
# MYSQL - Node A domains
# Production uses an external Aiven MySQL host; do not run MySQL in Compose.
############################################
MYSQL_HOST=replace-with-aiven-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=trybuy
MYSQL_USER=trybuy
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_POOL_SIZE=10
# SSL auto-enables for *.aivencloud.com hosts (app + migration runner). Override
# only for a non-Aiven TLS host: MYSQL_SSL=on|off, MYSQL_SSL_REJECT_UNAUTHORIZED=true.

############################################
# POSTGRESQL - Node B domains
# Production uses an external Aiven PostgreSQL host; do not run PostgreSQL in Compose.
############################################
PG_HOST=replace-with-aiven-postgres-host
PG_PORT=5432
PG_DATABASE=trybuy_inventory
PG_USERNAME=trybuy
PG_PASSWORD=replace-with-postgres-password
PG_POOL_SIZE=10
# SSL auto-enables for *.aivencloud.com hosts (app + migration runner). Override
# only for a non-Aiven TLS host: PG_SSL=on|off, PG_SSL_REJECT_UNAUTHORIZED=true.

############################################
# DATABASE MIGRATIONS
############################################
DB_MIGRATION_MANIFEST=database/migrations.manifest.json

############################################
# REDIS
############################################
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

############################################
# RABBITMQ
############################################
RMQ_URL=amqp://replace-with-rabbitmq-user:replace-with-rabbitmq-password@127.0.0.1:5672/rabbit-trybuy
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASS=replace-with-rabbitmq-password
RABBITMQ_VHOST=rabbit-trybuy
RABBITMQ_MANAGEMENT_PORT=15672

############################################
# MAIL (SMTP)
# Unset SMTP_HOST/USER/PASS disables outbound mail: the mailer logs and returns
# false instead of throwing, so password reset and order mails degrade quietly.
############################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-sender@example.com
SMTP_PASS=replace-with-smtp-app-password
# Defaults to SMTP_USER when unset.
SMTP_FROM=TryBuy <replace-with-sender@example.com>
# Comma-separated domains dropped BEFORE the SMTP dial (bounce protection).
# Unset uses the built-in list; setting it to "" disables the guard entirely.
MAIL_UNDELIVERABLE_DOMAINS=

############################################
# OBSERVABILITY
# GET /metrics is 404 while this is unset. Set it only when a scraper exists —
# the Prometheus registry is per-process, so GATEWAY_INSTANCES > 1 would need
# prom-client's cluster aggregator.
############################################
METRICS_TOKEN=

############################################
# CLOUDINARY
############################################
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

############################################
# GHN SHIPPING
############################################
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_TOKEN=replace-with-ghn-token
GHN_SHOP_ID=replace-with-ghn-shop-id
GHN_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Demo endpoint must stay false/blank in production.
GHN_DEMO_ENDPOINTS_ENABLED=false
ORDER_STALE_RESERVATION_TTL_HOURS=24

############################################
# PAYMENT - ZALOPAY
############################################
ZALOPAY_APP_ID=replace-with-zalopay-app-id
ZALOPAY_KEY1=replace-with-zalopay-key1
ZALOPAY_KEY2=replace-with-zalopay-key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2
# Fallback only — payments builds the real return URL from FRONTEND_URL
# (/payment-result?order=<ord_...>&method=<method>). Must be a FRONTEND page,
# never a gateway JSON endpoint.
ZALOPAY_REDIRECT_URL=http://localhost:5173/payment-result

############################################
# PAYMENT - VNPAY
############################################
VNP_TMN_CODE=replace-with-vnpay-tmn-code
VNP_HASH_SECRET=replace-with-vnpay-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Fallback only — see the ZALOPAY_REDIRECT_URL note above.
VNP_RETURN_URL=http://localhost:5173/payment-result
# VNPay calls this server-to-server after payment. Must be public for real callbacks.
VNPAY_IPN_URL=https://example.com/vnpay/callback

############################################
# TOOLING ONLY — never read by a running service
# These belong to scripts, not to the API. Export them in the shell that runs
# the script; they are listed here so the contract is complete.
############################################
# scripts/load/baseline.mjs — an existing buyer account for the load profiles.
# LOAD_USER=
# LOAD_PASS=
# scripts/test-chat-ws.mjs / test-chat-reply.mjs — two accounts that can chat.
# CHAT_USER_A_USERNAME=
# CHAT_USER_A_PASSWORD=
# CHAT_USER_B_USERNAME=
# CHAT_USER_B_PASSWORD=
# scripts/seed/seed-products.mjs reads .env.seed — see .env.seed.example
# (SEED_BASE, SEED_SHOP_USER/PASS, SEED_ADMIN_USER/PASS).
