{
  "name": "trybuy-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && nest build gateway && nest build orders && nest build user && nest build product && nest build social && nest build notification && nest build chat && nest build inventory && nest build payments && nest build rewards",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 startOrRestart ecosystem.config.js --env production --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:save": "pm2 save",
    "deploy:check": "node -c ecosystem.config.js && npx tsc --noEmit && npm run build",
    "start:prod:gateway": "node dist/apps/gateway/main",
    "start:prod:orders": "node dist/apps/orders/main",
    "start:prod:user": "node dist/apps/user/main",
    "start:prod:product": "node dist/apps/product/main",
    "start:prod:social": "node dist/apps/social/main",
    "start:prod:notification": "node dist/apps/notification/main",
    "start:prod:chat": "node dist/apps/chat/main",
    "start:prod:inventory": "node dist/apps/inventory/main",
    "start:prod:payments": "node dist/apps/payments/main",
    "start:prod:rewards": "node dist/apps/rewards/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint --fix \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "start:gateway": "nest start gateway --watch",
    "start:orders": "nest start orders --watch",
    "start:user": "nest start user --watch",
    "start:inventory": "nest start inventory --watch",
    "start:payments": "nest start payments --watch",
    "start:rewards": "nest start rewards --watch",
    "start:product": "nest start product --watch",
    "start:social": "nest start social --watch",
    "start:notification": "nest start notification --watch",
    "start:chat": "nest start chat --watch",
    "start:nodeA": "concurrently -n GATEWAY,ORDERS,USER,PRODUCT,SOCIAL,NOTIF,CHAT -c blue,green,pink,yellow,cyan,magenta,white \"npm run start:gateway\" \"npm run start:orders\" \"npm run start:user\" \"npm run start:product\" \"npm run start:social\" \"npm run start:notification\" \"npm run start:chat\"",
    "start:nodeB": "concurrently -n INVENTORY,PAYMENTS,REWARDS -c yellow,magenta,cyan \"npm run start:inventory\" \"npm run start:payments\" \"npm run start:rewards\"",
    "db:migrate:nodeA": "node scripts/migrate-database.mjs --target=nodeA --mode=apply",
    "db:migrate:nodeB": "node scripts/migrate-database.mjs --target=nodeB --mode=apply",
    "db:migrate:status": "node scripts/migrate-database.mjs --mode=status",
    "db:migrate:dry-run": "node scripts/migrate-database.mjs --mode=dry-run"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.7",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.24",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "accesscontrol": "^2.2.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "blockhash-core": "^0.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.8.2",
    "mysql2": "^3.15.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "vnpay": "^2.5.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    },
    "typeorm": {
      "brace-expansion": "^2.1.3"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.7",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/cached(|/.*)$": "<rootDir>/libs/cached/src/$1",
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^libs/(.*)$": "<rootDir>/libs/$1"
    }
  }
}
