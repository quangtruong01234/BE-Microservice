############################################
# NODE A (prod) — gateway + MySQL-backed services
# Copy to local/nodeA/.env on the EC2 host and fill CHANGE_ME_* values.
# Differences vs local are marked with  # <-- PROD
############################################

NODE_ENV=production                        # <-- PROD (siết CORS/cookie/swagger/synchronize)
GATEWAY_PORT=3000
GATEWAY_HOST=127.0.0.1                      # <-- PROD (chỉ Nginx public; gateway không bind ra ngoài)

# TypeORM: prod tự tắt synchronize; giữ tường minh, KHÔNG bật ALLOW_PRODUCTION
TYPEORM_SYNCHRONIZE=false                   # <-- PROD
TYPEORM_SYNCHRONIZE_ALLOW_PRODUCTION=false

############################################
# AUTH / CORS
############################################
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48 # <-- PROD (chuỗi random dài, KHÔNG dùng lại của local)
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://CHANGE_ME_storefront_domain,https://CHANGE_ME_ghn_console_domain  # <-- PROD (domain thật, bỏ localhost)
AUTH_COOKIE_SAME_SITE=lax                   # <-- PROD ('none' nếu FE khác site với API)
AUTH_COOKIE_SECURE=true                     # <-- PROD (cookie chỉ qua HTTPS)
SWAGGER_ENABLED=false                       # <-- PROD (ẩn /doc)
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_TTL_SECONDS=60
RATE_LIMIT_REDIS_TIMEOUT_MS=500
RATE_LIMIT_SKIP_PUBLIC_GET=true             # <-- PROD (only with nginx limit_req in front; skips Redis counter on @Public GETs without explicit @RateLimit)

############################################
# MYSQL (Aiven)
############################################
MYSQL_HOST=CHANGE_ME_aiven_mysql_host       # <-- PROD (host Aiven prod)
MYSQL_PORT=CHANGE_ME_aiven_mysql_port
MYSQL_DATABASE=CHANGE_ME_db_name
MYSQL_USER=CHANGE_ME_user
MYSQL_PASSWORD=CHANGE_ME_password
MYSQL_POOL_SIZE=30                          # <-- PROD (nâng từ 10; xem Aiven max_connections)
# SSL tự bật khi host chứa "aivencloud.com" (không cần khai báo biến SSL).

############################################
# DATABASE MIGRATIONS
############################################
DB_MIGRATION_MANIFEST=database/migrations.manifest.json

############################################
# REDIS (self-hosted trên EC2 qua docker-compose)
############################################
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password     # <-- PROD (khớp REDIS_PASSWORD của docker-compose)
REDIS_DB=0

############################################
# RABBITMQ
############################################
RMQ_URL=amqp://CHANGE_ME_user:CHANGE_ME_pass@127.0.0.1:5672/rabbit-trybuy
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=CHANGE_ME_user
RABBITMQ_PASS=CHANGE_ME_pass
RABBITMQ_VHOST=rabbit-trybuy
RABBITMQ_MANAGEMENT_PORT=15672

############################################
# CLOUDINARY
############################################
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
# Same Cloudinary account as dev. With NODE_ENV=production the server writes
# prod media to trybuy-prod/products and trybuy-prod/posts (separate from dev's
# trybuy/*). Driven by NODE_ENV — no Cloudinary folder env var to set.

############################################
# SMTP (order + forgot-password emails). Bỏ trống -> chỉ log, không gửi.
############################################
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=465
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASS=CHANGE_ME_smtp_app_password
SMTP_FROM=CHANGE_ME_from_address

############################################
# GHN SHIPPING
############################################
GHN_API_URL=https://CHANGE_ME_ghn_production_gateway/shiip/public-api  # <-- PROD (KHÔNG dùng dev-online-gateway)
GHN_API_TOKEN=CHANGE_ME_ghn_prod_token      # <-- PROD
GHN_SHOP_ID=CHANGE_ME_ghn_prod_shop_id      # <-- PROD
GHN_WEBHOOK_SECRET=CHANGE_ME_long_random    # <-- PROD (tự sinh, vd `openssl rand -base64 32`; khai báo y hệt trong GHN webhook dashboard)
GHN_DEMO_ENDPOINTS_ENABLED=true             # <-- DEMO (project demo giữ true để demo picking->delivering->delivered trên sandbox; project thật phải false)
ORDER_STALE_RESERVATION_TTL_HOURS=24
