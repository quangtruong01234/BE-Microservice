############################################
# NODE A (dev) — gateway + orders + user + product + social + notification + chat
#
# Copy to local/nodeA/.env. This lists ONLY what dev actually needs to set.
# Everything omitted uses a dev-correct default in code:
#   - TypeORM synchronize = on (auto-creates schema outside production)
#   - Auth cookie SameSite=lax / Secure=off; Swagger /doc = on
#   - Body limit 1mb; rate-limit 120 req / 60s; Redis 127.0.0.1:6379 (no password)
#   - MySQL SSL auto-enabled only when the host contains "aivencloud.com"
#   - MySQL pool size (MYSQL_POOL_SIZE) = 10; only raise it for prod/high-load
#   - SMTP unset -> reset/order emails are logged, not sent (no real delivery)
# See .env.production.example for the full prod-hardening reference.
############################################

NODE_ENV=development
GATEWAY_PORT=3000

############################################
# AUTH / CORS
############################################
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173,http://localhost:3013

############################################
# MYSQL (local, or an Aiven host — SSL turns on automatically for aivencloud.com)
############################################
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=trybuy
MYSQL_USER=trybuy
MYSQL_PASSWORD=replace-with-mysql-password

############################################
# RABBITMQ (Redis is also used but defaults to 127.0.0.1:6379 with no password)
############################################
RMQ_URL=amqp://replace-with-rabbitmq-user:replace-with-rabbitmq-password@127.0.0.1:5672/rabbit-trybuy
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASS=replace-with-rabbitmq-password
RABBITMQ_VHOST=rabbit-trybuy

############################################
# CLOUDINARY (required; upload folders switch by NODE_ENV -> dev uses trybuy/*)
############################################
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

############################################
# GHN SHIPPING (dev sandbox)
############################################
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_TOKEN=replace-with-ghn-token
GHN_SHOP_ID=replace-with-ghn-shop-id
GHN_WEBHOOK_SECRET=replace-with-a-long-random-secret
GHN_DEMO_ENDPOINTS_ENABLED=true            # demo project: keep the demo-status endpoint on
