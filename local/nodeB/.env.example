############################################
# NODE B (dev) — inventory + payments + rewards (PostgreSQL) + payment callbacks
#
# Copy to local/nodeB/.env. This lists ONLY what dev actually needs to set.
# Everything omitted uses a dev-correct default in code:
#   - TypeORM synchronize = on (auto-creates schema outside production)
#   - PG pool size = 10; PG SSL handled by the driver
# See .env.production.example for the full prod reference.
############################################

NODE_ENV=development

############################################
# POSTGRESQL (local; prod uses an external Aiven host)
############################################
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=trybuy_inventory
PG_USERNAME=trybuy
PG_PASSWORD=replace-with-postgres-password

############################################
# RABBITMQ
############################################
RMQ_URL=amqp://replace-with-rabbitmq-user:replace-with-rabbitmq-password@127.0.0.1:5672/rabbit-trybuy
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASS=replace-with-rabbitmq-password
RABBITMQ_VHOST=rabbit-trybuy

############################################
# FRONTEND (payments builds the ZaloPay/VNPay return URLs from this)
############################################
FRONTEND_URL=http://localhost:5173

############################################
# PAYMENT — ZALOPAY (sandbox; the service appends /create to the endpoint)
############################################
ZALOPAY_APP_ID=replace-with-zalopay-app-id
ZALOPAY_KEY1=replace-with-zalopay-key1
ZALOPAY_KEY2=replace-with-zalopay-key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2
ZALOPAY_REDIRECT_URL=http://localhost:3000/api/gateway/payment-result

############################################
# PAYMENT — VNPAY (sandbox)
############################################
VNP_TMN_CODE=replace-with-vnpay-tmn-code
VNP_HASH_SECRET=replace-with-vnpay-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/gateway/payment-result
VNPAY_IPN_URL=https://example.com/vnpay/callback
