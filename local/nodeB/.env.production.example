############################################
# NODE B (prod) — inventory + payments + rewards (PostgreSQL-backed)
# Copy to local/nodeB/.env on the EC2 host and fill CHANGE_ME_* values.
# Differences vs local are marked with  # <-- PROD
############################################

NODE_ENV=production                         # <-- PROD (bản local nodeB đang THIẾU biến này!)
TYPEORM_SYNCHRONIZE=false                    # <-- PROD (tắt auto-sync Postgres)
TYPEORM_SYNCHRONIZE_ALLOW_PRODUCTION=false

# FRONTEND_URL (payments dùng để dựng URL redirect ZaloPay/VNPay) KHÔNG khai báo
# ở đây: pm2 inject từ ecosystem.config.js và env của pm2 luôn thắng dotenv.
# Đặt lại ở file này là dead key. Đổi domain: sửa ecosystem.config.js rồi deploy.

############################################
# DATABASE MIGRATIONS
############################################
DB_MIGRATION_MANIFEST=database/migrations.manifest.json

############################################
# POSTGRESQL (Aiven)
############################################
PG_HOST=CHANGE_ME_aiven_pg_host             # <-- PROD
PG_PORT=CHANGE_ME_aiven_pg_port
PG_DATABASE=CHANGE_ME_db_name
PG_USERNAME=CHANGE_ME_user
PG_PASSWORD=CHANGE_ME_password
PG_POOL_SIZE=30                             # <-- PROD (nâng từ 10; xem Aiven max_connections)
# PG luôn kết nối TLS (rejectUnauthorized=false) — không cần khai báo biến SSL.

############################################
# RABBITMQ
############################################
RMQ_URL=amqp://CHANGE_ME_user:CHANGE_ME_pass@127.0.0.1:5672/rabbit-trybuy
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=CHANGE_ME_user
RABBITMQ_PASS=CHANGE_ME_pass
RABBITMQ_VHOST=rabbit-trybuy
RABBITMQ_MANAGEMENT_PORT=15672

############################################
# ZALOPAY (SANDBOX — demo project, giữ credentials + endpoint sandbox)
# Chỉ REDIRECT_URL trỏ về domain deploy thật để luồng redirect chạy được.
############################################
ZALOPAY_APP_ID=CHANGE_ME_sandbox_app_id      # sandbox (giống local)
ZALOPAY_KEY1=CHANGE_ME_sandbox_key1          # sandbox
ZALOPAY_KEY2=CHANGE_ME_sandbox_key2          # sandbox
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2          # sandbox BASE — service tự nối /create
ZALOPAY_REDIRECT_URL=https://CHANGE_ME_storefront_domain/payment/zalopay/return  # <-- PROD (domain deploy thật)

############################################
# VNPAY (SANDBOX — demo project, giữ credentials + endpoint sandbox)
# Chỉ RETURN_URL/IPN_URL trỏ về domain deploy thật.
############################################
VNP_TMN_CODE=CHANGE_ME_sandbox_tmn_code      # sandbox (giống local)
VNP_HASH_SECRET=CHANGE_ME_sandbox_hash_secret # sandbox
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html  # sandbox endpoint — giữ nguyên
VNP_RETURN_URL=https://CHANGE_ME_storefront_domain/payment/vnpay/return  # <-- PROD (domain deploy thật)
VNPAY_IPN_URL=https://CHANGE_ME_api_domain/vnpay/callback   # <-- PROD (domain public, VNPay gọi vào)
